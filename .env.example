# HeatSentinel Environment Variables (Alerts & Notifications)

# Dispatch Mode: set to 'true' for local testing without Twilio costs, 'false' for production
ALERT_MOCK_MODE=true

# Twilio SMS Configuration (Only required if ALERT_MOCK_MODE=false)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15005550006

# Redis Broker for Celery
REDIS_URL=redis://localhost:6379/0

# Database Configuration (Owned by Krishan)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/heatsentinel
